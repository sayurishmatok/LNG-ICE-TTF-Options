def collect_timesales(contract_symbols, start_time, end_time, product, contract_type):

    dfs = []

    for i in range(0, len(contract_symbols), 10):

        batch_contracts = contract_symbols[i:i + 10]
        batch_symbols = [s[0] for s in batch_contracts]

        if contract_type == "option":

            data = list(
                ice.get_timesales(
                    batch_symbols,
                    ["Price", "Size", "Conditions"],
                    start_time,
                    end_time,
                    filter="Blocks"
                )
            )

        else:

            data = list(
                ice.get_timesales(
                    batch_symbols,
                    ["Price", "Size"],
                    start_time,
                    end_time
                )
            )

        if len(data) <= 1:
            continue

        if data[0][0] == "Error":
            print(data[0])
            continue

        headers = data[0]
        rows = data[1:]

        for symbol, period, option_type, strike in batch_contracts:

            symbol_headers = [
                "Time",
                f"{symbol}.Price",
                f"{symbol}.Size"
            ]

            if contract_type == "option":
                symbol_headers.append(
                    f"{symbol}.Conditions"
                )

            try:
                idxs = [
                    headers.index(col)
                    for col in symbol_headers
                ]

            except ValueError:
                continue

            symbol_data = [symbol_headers]

            for row in rows:

                symbol_row = [
                    row[i]
                    for i in idxs
                ]

                if symbol_row[1] is None:
                    continue

                symbol_data.append(symbol_row)

            if len(symbol_data) <= 1:
                continue

            dfs.append(
                timesales_to_df(
                    symbol=symbol,
                    product=product,
                    period=period,
                    data=symbol_data,
                    option_type=option_type,
                    strike=strike
                )
            )

        time.sleep(1)

    if not dfs:

        print(f"No {contract_type} trades found")

        return pd.DataFrame()

    df = (
        pd.concat(dfs)
        .reset_index(drop=True)
    )

    if contract_type == "option":

        df["Has_Leg_Flag"] = (
            df["Conditions"]
            .fillna("")
            .str.contains("Leg", regex=False)
        )

    df["Trade_Time"] = pd.to_datetime(
        df["Trade_Time"]
    )

    print(
        f"Trades found for "
        f"{contract_type}: "
        f"{len(df)}"
    )

    return df

def group_deals(db, df, max_deal_id):

    df = build_deals(df)

    deals = (
        df.groupby("DealID")
        .agg(
            Symbol=("Symbol", "first"),
            Product=("Product", "first"),
            Period=("Period", "first"),
            Option_Type=("Option_Type", "first"),
            Strike=("Strike", "first"),
            Deal_Price=("Price", "first"),
            Total_Size=("Size", "sum"),
            Start_Time=("Trade_Time", "min"),
            End_Time=("Trade_Time", "max"),
            Has_Leg_Flag=("Has_Leg_Flag", "max")
        )
        .reset_index()
    )

    deals["OldDealID"] = deals["DealID"]

    deals = deals.sort_values(
        "Start_Time"
    ).reset_index(drop=True)

    deals["DealID"] = range(
        max_deal_id + 1,
        max_deal_id + 1 + len(deals)
    )

    mapping = dict(
        zip(
            deals["OldDealID"],
            deals["DealID"]
        )
    )

    df["DealID"] = df["DealID"].map(mapping)

    deals.drop(
        columns=["OldDealID"],
        inplace=True
    )

    return df, deals

