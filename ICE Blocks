def collect_contract_type(db, front_month, contract_type, parameter_class, table_name, product):
    
    contracts = get_front_month_contracts(db,front_month, product, parameter_class, table_name, contract_type) #get all contracts for that month

    contract_symbols = []

    for period, option_type, strike in contracts:
