def black76_price(F, K, T, r, sigma, option_type):
    """
    F = futures price
    K = strike
    T = time to expiry (years)
    r = risk-free rate
    sigma = volatility
    option_type = C or P
    """

    if sigma <= 0 or T <= 0:
        return None

    d1 = (
        log(F / K)
        + 0.5 * sigma**2 * T
    ) / (sigma * sqrt(T))

    d2 = d1 - sigma * sqrt(T)

    if option_type.upper() == "C":

        return exp(-r * T) * (
            F * norm.cdf(d1)
            - K * norm.cdf(d2)
        )

    elif option_type.upper() == "P":

        return exp(-r * T) * (
            K * norm.cdf(-d2)
            - F * norm.cdf(-d1)
        )

    else:
        raise ValueError("option_type must be C or P")

def implied_volatility(market_price, F, K, T, r, option_type):

    def objective(sigma):
        return (
            black76_price(F, K, T, r, sigma, option_type) - market_price)

    try:
        return brentq(objective, 1e-6, 5.0)
    except ValueError:
        return None

def get_option_settle(db, product, period, strike, option_type, option_time):

    options_params = Table(
        declarative_table=OptionsParameters,
        db_name="prices",
        table_name="options_parameters",
        db_details=db.db_details
    )

    options_values = Table(
        declarative_table=OptionsValues,
        db_name="prices",
        table_name="options_values",
        db_details=db.db_details
    )

    raw_params = options_params.filter_on_str_column({
        "Product": [product],
        "Period": [period],
        "Option_Type": [option_type],
        "Field": ["Settle"]
    })

    params = pd.DataFrame([vars(x) for x in raw_params])
    params["Strike"] = params["Strike"].astype(float)

    if params.empty:
        return None

    params = params[abs(params["Strike"] - strike) < 0.001]
    
    if params.empty:
        return None

    curve_id = params.iloc[0]["ID"]

    values = options_values.filter_on_str_column({"ID": [curve_id]})
    values = pd.DataFrame([vars(x) for x in values])

    values["Value"] = values["Value"].astype(float)
    values["Date"] = pd.to_datetime(values["Date"])

    if values.empty:
        return None

    trade_date = option_time.date()
    values = values[values["Date"].dt.date < trade_date]

    if values.empty:
        return None

    return values.sort_values("Date").iloc[-1]["Value"]

def classify_structure(package):

    leg_count = len(package)

    types = package["Option_Type"].tolist()
    strikes = package["Strike"].astype(float).tolist()
    expiries = package["Period"].tolist()
    sides = package["Side"].tolist()

    unique_strikes = len(set(strikes))
    unique_expiries = len(set(expiries))

    if leg_count == 1:
        return "Single Leg"

    # Straddle
    if (
        leg_count == 2
        and set(types) == {"C", "P"}
        and unique_strikes == 1
        and unique_expiries == 1
        and len(set(sides)) == 1
    ):
        return "Straddle"

    # Strangle
    if (
        leg_count == 2
        and set(types) == {"C", "P"}
        and unique_strikes == 2
        and unique_expiries == 1
        and len(set(sides)) == 1
    ):
        return "Strangle"

    # Call Spread
    if (
        leg_count == 2
        and all(t == "C" for t in types)
        and unique_strikes == 2
        and unique_expiries == 1
    ):
        return "Call Spread"

    # Put Spread
    if (
        leg_count == 2
        and all(t == "P" for t in types)
        and unique_strikes == 2
        and unique_expiries == 1
    ):
        return "Put Spread"

    # Risk Reversal
    if (
        leg_count == 2
        and set(types) == {"C", "P"}
        and unique_strikes == 2
        and unique_expiries == 1
        and len(set(sides)) == 2
    ):
        return "Risk Reversal"

    # Calendar
    if (
        leg_count == 2
        and unique_strikes == 1
        and unique_expiries == 2
    ):
        return "Calendar"

    # Butterfly
    if (
        leg_count == 3
        and len(set(types)) == 1
        and len(set(strikes)) == 3
    ):

        return "Butterfly"

    # Fence / Collar
    if (
        leg_count == 3
        and types.count("P") == 2
        and types.count("C") == 1
    ):
        return "Fence"

    return "Other"

def black76_gamma(F, K, T, r, sigma):

    d1 = (
        log(F / K)
        + 0.5 * sigma**2 * T
    ) / (sigma * sqrt(T))

    gamma = (
        exp(-r * T)
        * norm.pdf(d1)
        / (F * sigma * sqrt(T))
    )

    return gamma

def get_open_interest(db, product, period, strike, option_type, valuation_time):

    options_params = Table(
        declarative_table=OptionsParameters,
        db_name="prices",
        table_name="options_parameters",
        db_details=db.db_details
    )

    options_values = Table(
        declarative_table=OptionsValues,
        db_name="prices",
        table_name="options_values",
        db_details=db.db_details
    )

    raw_params = options_params.filter_on_str_column({
        "Product": [product],
        "Period": [period],
        "Option_Type": [option_type],
        "Field": ["Open Interest"]
    })

    params = pd.DataFrame([vars(x) for x in raw_params])

    if params.empty:
        return None

    params["Strike"] = params["Strike"].astype(float)

    row = params[
        abs(params["Strike"] - float(strike)) < 0.001
    ]

    if row.empty:
        return None

    param_id = row.iloc[0]["ID"]

    oi_values = pd.DataFrame(
        [
            vars(x)
            for x in options_values.filter_on_str_column(
                {"ID": [param_id]}
            )
        ]
    )

    if oi_values.empty:
        return None

    oi_values = oi_values[
        oi_values["Date"] <= valuation_time
    ].sort_values("Date")

    if oi_values.empty:
        return None

    base_oi = float(oi_values.iloc[-1]["Value"])

    if base_oi == 0:

        non_zero = oi_values[
            oi_values["Value"] > 0
        ]

        if not non_zero.empty:
            base_oi = float(
                non_zero.iloc[-1]["Value"]
            )

        else:
            base_oi = 0

    return base_oi

def plot_today_historical(db):

    deals_table = Table(
        declarative_table=ICEBlockDeals,
        db_name="prices",
        table_name="ice_block_deals",
        db_details=db.db_details
    )

    raw_deals = deals_table.fetch_all_rows()

    deals = pd.DataFrame([vars(x) for x in raw_deals])
    deals["Start_Time"] = pd.to_datetime(deals["Start_Time"])

    today = pd.Timestamp.today().normalize()

    today_deals = deals[deals["Start_Time"] >= today].copy()
    today_deals["GammaExposure"] = pd.to_numeric(today_deals["GammaExposure"], errors="coerce")
    today_deals = (today_deals.sort_values("Start_Time"))

    today_deals["RunningGammaExposure"] = (
        today_deals
        .groupby("Strike")
        ["GammaExposure"]
        .cumsum()
    )

    gamma_profile = (
        today_deals
        .groupby("Strike", as_index=False)
        ["RunningGammaExposure"]
        .last()
    )

    return gamma_profile

def collect(db):  
    front_month = get_front_month(db) #get front month eg OCT-2026

    options_contracts_symbols = collect_contract_type(db, front_month, "option", OptionsParameters, "options_parameters", "TFO") #get all option contracts
    futures_contracts_symbols = collect_contract_type(db, front_month, "future", FuturesParameters, "futures_parameters", "TTF")

    end_time = datetime.now()
    start_time = end_time - timedelta(minutes=10)

    start_time = start_time.strftime("%Y-%m-%dT%H:%M:%S")
    end_time = end_time.strftime("%Y-%m-%dT%H:%M:%S")

    #collect trades for options and futures within the last 5 minutes
    options_df = collect_timesales(options_contracts_symbols, start_time, end_time, "TFO", "option") #get all option trades
    futures_df = collect_timesales(futures_contracts_symbols, start_time, end_time, "TFM", "future")

    #group option trades into deals
    max_deal_id = get_max_deal_id(db)
    options_df, options_deals = group_deals(db, options_df, max_deal_id)

    options_deals["IV"] = None
    options_deals["IV_Status"] = None
    options_deals["Settle_IV"] = None
    options_deals["Vol_Move"] = None
    options_deals["DealerSign"] = None
    options_deals["PackageID"] = None
    options_deals["Structure"] = None
    options_deals["Gamma"] = None
    options_deals["OpenInterest"] = None
    options_deals["GammaExposure"] = None
    options_deals["RunningGammaExposure"] = None
    options_deals["Side"] = None

    #find futures leg
    for _, options_deal in options_deals.iterrows():

        option_time = options_deal["Start_Time"]

        prior_futures = futures_df[
            (futures_df["Trade_Time"] <= option_time)
            &
            (
                futures_df["Trade_Time"]
                >= option_time - timedelta(seconds=30)
            )
        ]
        
        #Black-76
        status = None
        iv = None

        if prior_futures.empty:
            status = "NO_FUTURES_MATCH"

        else:

            latest_future = (
                prior_futures
                .sort_values("Trade_Time")
                .iloc[-1]
            )

            F = float(latest_future["Price"])
            K = float(options_deal["Strike"])
            premium = float(options_deal["Deal_Price"])
            option_type = options_deal["Option_Type"]

            expiry = get_expiry_for_period(db, options_deal["Product"], options_deal["Period"])

            T = None

            if expiry is not None:

                T = (expiry - option_time).total_seconds() / (365 * 24 * 3600)

            if expiry is None:
                status = "NO_EXPIRY"

            elif T <= 0:
                status = "EXPIRED"

            else:

                intrinsic = (
                    max(K - F, 0)
                    if option_type == "P"
                    else max(F - K, 0)
                )
                
                time_value = premium - intrinsic

                if time_value <= 0:
                    status = "NO_TIME_VALUE"

                else:

                    iv = implied_volatility(market_price=premium, F=F, K=K, T=T, r=0.0219, option_type=option_type)

                    if iv is None:
                        status = "NO_IV_SOLUTION"

                    else:
                        status = "OK"

        options_deals.loc[
            options_deals["DealID"] == options_deal["DealID"],
            "IV"
        ] = iv

        options_deals.loc[
            options_deals["DealID"] == options_deal["DealID"],
            "IV_Status"
        ] = status

        # compare to settlement
        settle_iv = None
        vol_move = None
        dealer_sign = None

        if status == "OK":

            settle_price = get_option_settle(
                db,
                options_deal["Product"],
                options_deal["Period"],
                K,
                option_type,
                option_time
            )

            if settle_price is None:

                print(
                    f"Deal={options_deal['DealID']} | "
                    f"FAILED: No settlement price found"
                )

            else:

                # settlement IV calculation
                other_type = "P" if option_type == "C" else "C"
                other_settle = get_option_settle(db, options_deal["Product"], options_deal["Period"], K, other_type, option_time)

                if other_settle is None:
                    status = "NO_OTHER_SETTLE"

                else:

                    call_settle = settle_price if option_type == "C" else other_settle
                    put_settle = settle_price if option_type == "P" else other_settle

                    parity_forward = K + call_settle - put_settle

                    settle_iv = implied_volatility(market_price=settle_price, F=parity_forward, K=K, T=T, r=0.0219, option_type=option_type) 

                if settle_iv is None:

                    print(
                        f"Deal={options_deal['DealID']} | "
                        f"FAILED: Settlement IV calculation returned None | "
                        f"Type={option_type} | "
                        f"F={F} | "
                        f"K={K} | "
                        f"T={T} | "
                        f"SettlePrice={settle_price}"
                    )

                else:

                    vol_move = iv - settle_iv

                    if iv > settle_iv:
                        dealer_sign = -1 #customer bought vol
                        side = "Buy"
                    else:
                        dealer_sign = 1 #customer sold vol
                        side = "Sell"

                    options_deals.loc[
                        options_deals["DealID"] == options_deal["DealID"],
                        "DealerSign"
                    ] = dealer_sign

                    options_deals.loc[
                        options_deals["DealID"] == options_deal["DealID"],
                        "Side"
                    ] = side

                    gamma = black76_gamma(F=F, K=K, T=T, r=0.0219, sigma=iv)

                    options_deals.loc[
                        options_deals["DealID"] == options_deal["DealID"],
                        "Gamma"
                    ] = gamma

                    base_oi = get_open_interest(db, options_deal["Product"], options_deal["Period"], K, option_type, option_time)
                    flow_volume = float(options_deal["Total_Size"])

                    options_deals.loc[
                        options_deals["DealID"] == options_deal["DealID"],
                        "OpenInterest"
                    ] = base_oi

                    if (
                        gamma is not None  
                        and base_oi is not None
                        and dealer_sign is not None
                    ):

                        oigex = (gamma * base_oi)
                        flowgex = (gamma * flow_volume * dealer_sign)
                        total_gex = oigex + flowgex

                        options_deals.loc[
                            options_deals["DealID"] == options_deal["DealID"],
                            "GammaExposure"
                        ] = total_gex

                        print( ######delete
                            f"Strike={K} | "
                            f"OI={base_oi} | "
                            f"Flow={flow_volume} | "
                            f"OIGEX={oigex:.2f} | "
                            f"FlowGEX={flowgex:.2f} | "
                            f"TotalGEX={total_gex:.2f}"
                        ) ########delete

        options_deals.loc[
            options_deals["DealID"] == options_deal["DealID"],
            "Settle_IV"
        ] = settle_iv

        options_deals.loc[
            options_deals["DealID"] == options_deal["DealID"],
            "Vol_Move"
        ] = vol_move

        if vol_move is not None:

            print(
                f"Deal {options_deal['DealID']} | "
                f"Option Type={option_type} | "
                f"Status={status} | "
                f"Trade IV={iv:.2%} | "
                f"Settle IV={settle_iv:.2%} | "
                f"Vol Move={vol_move:.2%} | "
                f"DealerSign={dealer_sign}"
            )

    #phase 3
    options_deals["PackageTime"] = (
        options_deals["Start_Time"]
        .dt.floor("5s")
    )

    options_deals["PackageID"] = (
        options_deals
        .groupby(
            [
                "Product",
                "Period",
                "PackageTime",
                "Total_Size",
                "Deal_Price"
            ]
        )
        .ngroup()
        + 1
    )

    options_deals.drop(columns=["PackageTime"],inplace=True)

    for package_id in options_deals["PackageID"].unique():
        
        package = options_deals[
            options_deals["PackageID"] == package_id
        ]

        structure = classify_structure(package)

        options_deals.loc[
            options_deals["PackageID"] == package_id,
            "Structure"
        ] = structure

    ########DELETE
    print(
        options_deals[
            [
                "DealID",
                "PackageID",
                "Option_Type",
                "Strike",
                "Total_Size",
                "Start_Time"
            ]
        ]
        .sort_values(["PackageID", "Strike"])
    )
    ################DELETE

    #phase 4
    gamma_profile = (
        options_deals
        .groupby("Strike", as_index=False)
        ["GammaExposure"]
        .sum()
    )

    print(gamma_profile.sort_values("Strike"))

    #plot today's historical deals
    historical_gamma_profile = plot_today_historical(db)

    plt.figure(figsize=(12, 6))
    plt.plot(
        historical_gamma_profile["Strike"],
        historical_gamma_profile["RunningGammaExposure"],
        marker="o"
    )

    plt.axhline(0, color="black", linewidth=1)
    plt.title("Today-to-Date Running Gamma Exposure")
    plt.xlabel("Strike")
    plt.ylabel("Running Gamma Exposure")
    plt.grid(True)
    plt.savefig("running_gamma_profile.png")
    print("Saved plot: running_gamma_profile.png")
    plt.close()

    #upload to database
    upload_to_db(db, options_df, options_deals, "ice_block_trades", "ice_block_deals", "option")
    upload_to_db(db, futures_df, None, "ice_block_trades", None, "future")

