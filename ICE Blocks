def get_front_month(db):

    expiry_params = Table(
        declarative_table=ExpiryParameters,
        db_name="prices",
        table_name="expiry_parameters",
        db_details=db.db_details
    )

    expiry_values = Table(
        declarative_table=ExpiryValues,
        db_name="prices",
        table_name="expiry_values",
        db_details=db.db_details
    )

    params = expiry_params.filter_on_str_column({
        "Product": ["TFO"]
    })

    today = datetime.now()

    candidates = []

    for p in params:

        vals = expiry_values.filter_on_str_column({
            "ID": [p.ID]
        })

        if not vals:
            continue

        expiry = vals[0].Value

        days_to_expiry = (expiry - today).days

        if days_to_expiry > 5:
            candidates.append(
                (expiry, p.Period)
            )

    candidates.sort()

    if not candidates:
        raise ValueError("No front month found with >5 days to expiry")
    
    return candidates[0][1]

def get_front_month_contracts(db, period, product, parameter_class, table_name, contract_type):

    t = Table(
        declarative_table=parameter_class,
        db_name="prices",
        table_name=table_name,
        db_details=db.db_details
    )

    rows = t.filter_on_str_column({
        "Product": [product],
        "Period": [period],
        "Field": ["Settle"]
    })

    contracts = set()

    for r in rows:
        if contract_type == "option":
            contracts.add((r.Period, r.Option_Type, r.Strike))
        elif contract_type == "future":
            contracts.add((r.Period, None, None))
        else:
            raise ValueError("Invalid contract_type. Must be 'option' or 'future'.")

    return sorted(list(contracts))
        
def build_ice_symbol(period, contract_type, option_type=None, strike=None, product=None):

    month_map = {"JAN": "F","FEB": "G","MAR": "H","APR": "J","MAY": "K","JUN": "M","JUL": "N","AUG": "Q","SEP": "U","OCT": "V","NOV": "X","DEC": "Z",}

    ice_mapping = {"TTF": "TFM",}
    ice_product = ice_mapping.get(product, product)

    month, year = period.split("-")
    year = year[-2:]

    if contract_type == 'option':
        strike_code = int(round(strike * 100))

        return (
            f"{ice_product} "
            f"{year}"
            f"{month_map[month]}"
            f"{option_type}"
            f"{strike_code}"
            f"-ICN"
        )

    elif contract_type == 'future':
        return (
            f"{ice_product} "
            f"{year}"
            f"{month_map[month]}"
            f"-ICN"
        )
    else:
        raise ValueError("Invalid contract_type. Must be 'option' or 'future'.")

def timesales_to_df(symbol, product, period, data, option_type=None, strike=None):

    headers = data[0]
    rows = data[1:]

    df = pd.DataFrame(rows, columns=headers)

    df["Symbol"] = symbol
    df["Product"] = product
    df["Period"] = period
    df["Option_Type"] = option_type
    df["Strike"] = strike

    df.rename(
        columns={
            "Time": "Trade_Time",
            f"{symbol}.Price": "Price",
            f"{symbol}.Size": "Size",
            f"{symbol}.Conditions": "Conditions"
        },
        inplace=True
    )

    if "Conditions" not in df.columns:
        df["Conditions"] = None

    return df[
        [
            "Symbol",
            "Product",
            "Period",
            "Option_Type",
            "Strike",
            "Trade_Time",
            "Price",
            "Size",
            "Conditions"
        ]
    ]

def build_deals(df, window_seconds=180):

    df = df.sort_values(
        ["Symbol", "Price", "Trade_Time"]
    ).copy()

    deal_counter = 0

    all_groups = []

    for (symbol, price), grp in df.groupby(
        ["Symbol", "Price"]
    ):

        grp = grp.sort_values("Trade_Time").copy()

        deal_ids = []

        previous_time = None

        for _, row in grp.iterrows():

            if previous_time is None:

                deal_counter += 1

            else:

                gap = (
                    row["Trade_Time"]
                    - previous_time
                ).total_seconds()

                if gap > window_seconds:

                    deal_counter += 1

            deal_ids.append(deal_counter)

            previous_time = row["Trade_Time"]

        grp["DealID"] = deal_ids

        all_groups.append(grp)

    return pd.concat(all_groups).sort_values("Trade_Time")

